{
  "name": "zen-fs-webdav",
  "version": "0.1.3",
  "description": "一个简单、现代的 WebDAV 客户端库，提供类似文件系统的 API",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "build:umd": "tsup",
    "build:all": "npm run build && npm run build:umd",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepublishOnly": "npm run build:all",
    "clean": "rimraf dist"
  },
  "keywords": [
    "webdav",
    "filesystem",
    "fs",
    "client",
    "api",
    "browser",
    "node"
  ],
  "author": "Richard",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/weijia/zen-fs-webdav.git"
  },
  "bugs": {
    "url": "https://github.com/weijia/zen-fs-webdav/issues"
  },
  "homepage": "https://github.com/weijia/zen-fs-webdav#readme",
  "devDependencies": {
    "@types/he": "^1.2.3",
    "@types/jest": "^29.5.0",
    "@types/node": "^18.15.11",
    "@typescript-eslint/eslint-plugin": "^5.57.1",
    "@typescript-eslint/parser": "^5.57.1",
    "@zenfs/core": "^2.3.3",
    "eslint": "^8.38.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^29.5.0",
    "prettier": "^3.9.6",
    "rimraf": "^5.0.0",
    "ts-jest": "^29.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.0.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@richard432/localstorage-logger": "^0.1.0",
    "fast-xml-parser": "^5.2.5",
    "he": "^1.2.0"
  }
}
